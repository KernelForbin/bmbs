# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Right-click the intake channel in Discord (Developer Mode must be on) -> Copy Channel ID
DISCORD_CHANNEL_ID=

# Optional: comma-separated Discord user IDs allowed to trigger a push.
# Leave blank to allow anyone who can post in the channel.
DISCORD_ALLOWED_USER_IDS=

# Fine-grained GitHub PAT scoped to ONLY this repo, with
# "Contents: Read and write" permission and nothing else.
GITHUB_TOKEN=

GITHUB_REPO=KernelForbin/bmbs
GITHUB_BRANCH=main

# Seconds to wait for a confirmation reaction before giving up.
CONFIRM_TIMEOUT_SECONDS=60
