[Unit]
Description=bmbs.bet Discord picks intake bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these two paths for your machine.
WorkingDirectory=/home/YOUR_USER/bmbs/discord-bot
ExecStart=/home/YOUR_USER/bmbs/discord-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/YOUR_USER/bmbs/discord-bot/.env

[Install]
WantedBy=multi-user.target
